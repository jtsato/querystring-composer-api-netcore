<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!-- Held on the 2.x line on purpose: 3.x is a code migration (LINQ2 removal, namespace
             consolidation) that has not been done yet. -->
        <PackageReference Include="MongoDB.Bson" />
        <PackageReference Include="MongoDB.Driver" />
        <PackageReference Include="System.Runtime.Caching" />
        <!-- Transitive deps of MongoDB.Driver 2.30.0, pinned forward to clear NU1902/NU1903.
             The driver floats them at >= 0.30.1 / >= 1.0.0, which are the vulnerable versions.
             Drop these once the driver itself requires the patched ranges. -->
        <PackageReference Include="SharpCompress" />
        <PackageReference Include="Snappier" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Core\Core.csproj">
            <CopyLocalSatelliteAssemblies>true</CopyLocalSatelliteAssemblies>
        </ProjectReference>
    </ItemGroup>

</Project>
